<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Palomar" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#CBB4FF</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="Theme.Palomar.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/palomar_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Palomar</item>
        <item name="isLightTheme">false</item>
    </style>
</resources>
